---
/**
 * Çizgi yumağı — Gonca'nın program görsellerindeki motifin vektör karşılığı.
 * İletişimin düğümünü anlatır. Çizimin kendisi TangleSprite'ta bir kez durur;
 * bu bileşen ona bağlanır, rengini `currentColor`dan alır.
 *
 * Kullanan sayfa TangleSprite'ı bir kez render etmelidir.
 */
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---

<svg class={cls} viewBox="0 0 500 500" fill="none" aria-hidden="true" focusable="false">
  <use href="#brand-tangle" />
</svg>
