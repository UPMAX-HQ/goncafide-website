/** Danışmanlığın devreye girdiği tipik durumlar. */
const consultingCases = [
  'İki ekip ya da iki departman arasında tıkanmış, toplantılarda dönüp duran bir mesele',
  'Bir yönetici ile ekibi arasında aşınmış güven',
  'Ortaklar arasında, kararların alınamadığı bir anlaşmazlık',
  'Tedarikçi, müşteri ya da iş ortağıyla sürtüşmeye dönüşmüş bir ilişki',
