  trigger: '<path d="M13 2.5 5.5 13H11l-1.5 8.5L18 11h-5.5l.5-8.5Z"/>',
  burnout: '<path d="M12 21c3.3 0 6-2.5 6-5.6 0-3.6-3-5.3-3.6-8.9-1.6 1.2-2.4 2.8-2.4 4.4 0 1.2-.8 1.8-1.5 1.2-.8-.7-1-1.9-.9-2.9C7.6 10.7 6 13 6 15.4 6 18.5 8.7 21 12 21Z"/>',
