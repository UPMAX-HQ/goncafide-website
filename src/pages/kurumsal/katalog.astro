  power: '<circle cx="7.5" cy="8" r="2.5"/><circle cx="16.5" cy="8" r="2.5"/><path d="M3 19c0-2.5 2-4.2 4.5-4.2S12 16.5 12 19M12 19c0-2.5 2-4.2 4.5-4.2S21 16.5 21 19"/>',
