<PageLayout
  title="Kurumsal Eğitim Kataloğu"
  description="Gonca Fide’nin kurumlara yönelik Şiddetsiz İletişim eğitim kataloğu: ekip içi iletişim, geri bildirim kültürü, anlaşmazlık dönüştürme ve liderlikte güç ayrımları. PDF olarak indirilebilir."
>
  <JsonLd slot="jsonld" schema={schema} />

  <!-- PDF kapağı — yalnızca baskıda görünür -->
  <section class="pdf-cover print-only">
    <Tangle class="pdf-cover-tangle" />
    <div class="pdf-cover-inner">
      <div class="pdf-lockup">
        <svg viewBox="0 0 64 64" fill="none" aria-hidden="true">
          <rect width="64" height="64" rx="14" fill="#F6ECF3"/>
          <text x="31" y="46" text-anchor="middle" font-family="Lora, Georgia, serif"
                font-size="44" font-style="italic" fill="#3D2150">g</text>
          <circle cx="45" cy="22" r="4.5" fill="#B14CC0"/>
        </svg>
        <div>
          <b>Gonca Fide</b>
          <span>birbirine bağlar güçlendirir</span>
        </div>
      </div>

      <div class="pdf-cover-mid">
        <p class="pdf-kicker">Kurumsal Eğitim Kataloğu</p>
